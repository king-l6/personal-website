# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real credentials.

# Base URL of the Anthropic-format LLM gateway used by /studio.
# Example shape: https://<gateway-host>
ANTHROPIC_BASE_URL=

# API key for that gateway. Server-side only: it is read inside the
# /studio Server Action and never reaches the browser bundle.
ANTHROPIC_API_KEY=

# Model name to send to the gateway. Required: gateways name their models
# differently, so there is no sensible default. Use whatever the gateway
# actually exposes.
ANTHROPIC_MODEL=
